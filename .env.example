# Machine-specific environment overrides for the TejaForce SDK pipeline.
# Copy this file to .env (gitignored) and set values for your machine.
# Variables already set in your shell always take precedence over .env
# (same semantics as python-dotenv's load_dotenv(override=False)).

# Conda environment the pipeline orchestrator AND agents run cogwheel in.
# Must contain both `cogwheel` and a compatible `claude-agent-sdk` for the
# Claude backend (see .serena/memories/pipeline_environment_setup.md). The
# Codex backend uses the installed `codex` CLI and does not add a Python SDK
# dependency. Consumed by .claude/sdk/launch_build.sh, .claude/build, and
# .codex/build; defaults to cogwheel_310 when unset, so only uncomment/change
# this if your env is named differently.
# SDK_CONDA_ENV=cogwheel_310

# Optional Codex backend overrides. By default the shared pipeline routes
# scientific-authority roles to gpt-5.6-sol/high and bounded support roles to
# gpt-5.6-terra/medium. A global override replaces every role; a role-specific
# override (for example CODEX_MODEL_TEST_DEV) takes precedence over the global
# value. Role keys are the uppercase names under .codex/agents/.
# CODEX_MODEL=
# CODEX_REASONING_EFFORT=high
# CODEX_MODEL_TEST_DEV=
# CODEX_REASONING_EFFORT_TEST_DEV=

# TCP port for the Claude SDK pipeline's shared Serena SSE server (default 8322).
# Set a different port on machines where a sibling repo's pipeline (e.g.
# gw_detection_ias) also runs builds: both hardcoding 8322 makes
# simultaneous builds collide at startup, and each repo's watchdog kills
# whatever listens on its port. Consumed by launch_build.sh, .claude/build
# (exported), .claude/sdk/agents.py (SerenaManager), and watchdog.sh.
# SDK_SERENA_PORT=8323

# TCP port for the Codex pipeline's shared Serena Streamable HTTP server. Keep this
# distinct from SDK_SERENA_PORT so Claude and Codex builds can run
# simultaneously without binding or watchdog collisions.
# CODEX_SERENA_PORT=8324

# Tidier scheduling. By default the Tidier is a POST-COMMIT ADVISORY role and
# its in-DAG build step is SKIPPED (it previously ran last over the whole build
# diff and its error_max_turns finalization could kill the DAG via the anyio
# cancel-scope bug). Set SDK_RUN_TIDIER=1 to opt the in-DAG tidier back in.
# SDK_SKIP_TIDIER=1 remains honored as a hard override that always skips it.
# SDK_RUN_TIDIER=1
