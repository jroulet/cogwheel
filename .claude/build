#!/usr/bin/env bash
# Launch the SDK build pipeline.
# Usage: .claude/build "task description" [--fast] [--plan-only] [-v] [-q]
#
# PLACEHOLDER: update ENV_NAME with the project's environment name.

REPO_ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"

# PLACEHOLDER: update environment resolution for your project.
# For conda: ENV_NAME="myenv"
# For venv: source "$REPO_ROOT/.venv/bin/activate"
ENV_NAME="cogwheel_310"

if command -v conda >/dev/null 2>&1; then
    exec conda run --no-capture-output -n "$ENV_NAME" \
      python "$REPO_ROOT/.claude/sdk/build.py" build "$@"
else
    exec python "$REPO_ROOT/.claude/sdk/build.py" build "$@"
fi
