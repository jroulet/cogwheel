#!/usr/bin/env bash
# Launch the SDK build pipeline.
# Usage: .claude/build "task description" [--fast] [--plan-only] [-v] [-q]
#
# Conda env resolves from SDK_CONDA_ENV / .env (copy .env.example), default cogwheel_310.

REPO_ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"

# Conda env routing via the durable .env idiom: shell SDK_CONDA_ENV wins,
# then .env at the repo root, then the default. Copy .env.example to .env
# to set it per machine.
if [[ -f "$REPO_ROOT/.env" ]] && [[ -z "${SDK_CONDA_ENV:-}" ]]; then
  SDK_CONDA_ENV="$(grep -E '^SDK_CONDA_ENV=' "$REPO_ROOT/.env" | cut -d= -f2- | tr -d '"' | tr -d "'")"
fi
ENV_NAME="${SDK_CONDA_ENV:-cogwheel_310}"

# Per-repo Serena SSE port (see launch_build.sh): shell > .env > 8322.
if [[ -f "$REPO_ROOT/.env" ]] && [[ -z "${SDK_SERENA_PORT:-}" ]]; then
  SDK_SERENA_PORT="$(grep -E '^SDK_SERENA_PORT=' "$REPO_ROOT/.env" | cut -d= -f2- | tr -d '"' | tr -d "'")"
fi
export SDK_SERENA_PORT="${SDK_SERENA_PORT:-8322}"

if command -v conda >/dev/null 2>&1; then
    exec conda run --no-capture-output -n "$ENV_NAME" \
      python "$REPO_ROOT/.claude/sdk/build.py" build "$@"
else
    exec python "$REPO_ROOT/.claude/sdk/build.py" build "$@"
fi
