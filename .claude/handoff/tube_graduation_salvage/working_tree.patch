+def _fill_cusp_tails(theta_fine: np.ndarray, delta_tau: np.ndarray,
+                     i_lo: int, i_hi: int) -> np.ndarray:
+    """Fill refused near-cusp tails of ``delta_tau`` via the A3 cusp law.
+
+    ``_merging_fold_pair`` declines inside the cusp tie window (``_CUSP_TIE_EPS``),
+    leaving ``NaN`` tails at one or both arc ends.  Near a fold cusp the
+    merging-pair delay separation follows the cusp (A3) scaling ``Delta_tau ~
+    d^{2/3}`` in the distance-to-cusp ``d``, so ``g = Delta_tau^{3/2}`` is
+    LINEAR in ``theta`` there.  Each tail (indices outside the servable run
+    ``[i_lo, i_hi]``) is filled by linearly extrapolating ``g`` from the
+    servable boundary node and its inner neighbour, then inverting
+    ``Delta_tau = max(g, 0)^{2/3}``.  The implied cusp sits at the linear root
+    of ``g`` (``d = 0``); past it ``Delta_tau`` is clamped to ``0``.  This pins
+    the near-cusp knot spacing to the same ``d^{2/3}`` law the wedge/lobe
+    ``u = d^{2/3}`` axes use, without needing the exact cusp centre.
+
+    Parameters
+    ----------
+    theta_fine : np.ndarray
+        Uniform, strictly ascending theta grid (shape ``(n_map,)``).
+    delta_tau : np.ndarray
+        Fold-pair delay separation with ``NaN`` in the refused tails and
+        finite, positive values over ``[i_lo, i_hi]``.
+    i_lo, i_hi : int
+        First and last indices of the servable (finite) run.
+
+    Returns
+    -------
+    np.ndarray
+        A copy of ``delta_tau`` with both tails filled (shape ``(n_map,)``).
+    """
+    if i_hi - i_lo < 1:
+        raise ValueError(
+            'Tube delay map needs at least two servable nodes to extrapolate '
+            f'the cusp tails; got a servable run of length {i_hi - i_lo + 1}.')
+    filled = np.array(delta_tau, dtype=float)
+    two_thirds = 2.0 / 3.0
+
+    def _extend(tail_indices: np.ndarray, boundary: int, inner: int) -> None:
+        g_boundary = float(filled[boundary]) ** 1.5
+        g_inner = float(filled[inner]) ** 1.5
+        slope = (g_boundary - g_inner) / (
+            float(theta_fine[boundary]) - float(theta_fine[inner]))
+        g_tail = g_boundary + slope * (
+            theta_fine[tail_indices] - float(theta_fine[boundary]))
+        filled[tail_indices] = np.maximum(g_tail, 0.0) ** two_thirds
+
+    if i_lo > 0:
+        _extend(np.arange(0, i_lo), i_lo, i_lo + 1)
+    if i_hi < filled.size - 1:
+        _extend(np.arange(i_hi + 1, filled.size), i_hi, i_hi - 1)
+    return filled
