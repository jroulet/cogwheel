{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "uvx", "--from", "git+https://github.com/oraios/serena",
        "--with", "pyright[nodejs]",
        "serena", "start-mcp-server",
        "--project-from-cwd",
        "--context", "claude-code"
      ],
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "permission": {
        "read": "deny",
        "edit": "deny",
        "glob": "deny",
        "grep": "deny",
        "bash": "allow",
        "task": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow",
        "external_directory": {
          "/tmp/opencode/*": "allow",
          "*": "allow"
        }
      }
    }
  },
  "permission": {
    "read": "deny",
    "edit": "deny",
    "glob": "deny",
    "grep": "deny",
    "bash": "allow",
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "external_directory": {
      "/tmp/opencode/*": "allow",
      "*": "allow"
    }
  },
  "experimental": {
    "mcp_timeout": 180000
  }
}