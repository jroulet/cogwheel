#!/usr/bin/env bash
# Launch the shared build pipeline with Codex as the agent runtime.
# Claude remains the default when using .claude/build directly.

set -u

REPO_ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"

# Keep Codex's build Serena disjoint from the Claude build port. Shell value
# wins, then the repo's untracked .env, then 8324.
if [[ -f "$REPO_ROOT/.env" ]] && [[ -z "${CODEX_SERENA_PORT:-}" ]]; then
  CODEX_SERENA_PORT="$(grep -E '^CODEX_SERENA_PORT=' "$REPO_ROOT/.env" | cut -d= -f2- | tr -d '"' | tr -d "'")"
fi
export CODEX_SERENA_PORT="${CODEX_SERENA_PORT:-8324}"
export AGENT_PROVIDER=codex

BUILD_ARGS=("$@")
BUILD_LOG=""
for (( INDEX = 0; INDEX < ${#BUILD_ARGS[@]}; INDEX++ )); do
  case "${BUILD_ARGS[$INDEX]}" in
    --log)
      if (( INDEX + 1 < ${#BUILD_ARGS[@]} )); then
        BUILD_LOG="${BUILD_ARGS[$((INDEX + 1))]}"
      fi
      ;;
    --log=*) BUILD_LOG="${BUILD_ARGS[$INDEX]#--log=}" ;;
  esac
done
if [[ -z "$BUILD_LOG" ]]; then
  BUILD_LOG="/tmp/codex_build_$(date +%Y%m%d_%H%M%S_%N).log"
  BUILD_ARGS+=(--log "$BUILD_LOG")
fi

STALE_SECONDS="${CODEX_BUILD_STALE_SECONDS:-1200}"
BUILD_EVENT_ID="${CODEX_BUILD_EVENT_ID:-build-$(date +%s%N)-$$-${RANDOM}}"

"$REPO_ROOT/.claude/build" --provider codex "${BUILD_ARGS[@]}" \
  > /dev/null 2>&1 &
BUILD_PID=$!
"$REPO_ROOT/.claude/sdk/watchdog.sh" "$BUILD_LOG" "$STALE_SECONDS" \
  "$BUILD_PID" > /dev/null 2>&1 &
WATCHDOG_PID=$!

WATCHDOG_LOG="${BUILD_LOG%.log}.watchdog.log"
for _ in $(seq 1 70); do
  grep -q "Watching orchestrator PID" "$WATCHDOG_LOG" 2>/dev/null && break
  kill -0 "$WATCHDOG_PID" 2>/dev/null || break
  sleep 1
done
if grep -q "Watching orchestrator PID" "$WATCHDOG_LOG" 2>/dev/null; then
  echo "[codex] launched: $BUILD_LOG (watchdog ${STALE_SECONDS}s)"
else
  echo "[codex] WARNING: watchdog did not attach; see $WATCHDOG_LOG" >&2
fi
if [[ -n "${CODEX_THREAD_ID:-}" ]] && [[ "${CODEX_EVENT_RESUME:-1}" != "0" ]]; then
  echo "[codex] terminal/escalation callbacks armed for this thread"
else
  echo "[codex] no CODEX_THREAD_ID; autonomous wake-up is unavailable"
fi

STATUS=0
wait "$BUILD_PID" || STATUS=$?

if [[ -n "${CODEX_THREAD_ID:-}" ]] && [[ "${CODEX_EVENT_RESUME:-1}" != "0" ]]; then
  nohup "$REPO_ROOT/.codex/resume_driver.sh" build_terminal \
    "exit_status=$STATUS log=$BUILD_LOG" "$BUILD_EVENT_ID" \
    </dev/null >/dev/null 2>&1 &
fi
exit "$STATUS"
