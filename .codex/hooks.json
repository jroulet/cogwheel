{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec \"$(git rev-parse --show-toplevel)/.codex/hooks/session-start.sh\"'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__serena__execute_shell_command|mcp__serena_build__execute_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec \"$(git rev-parse --show-toplevel)/.codex/hooks/conda-python.sh\"'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|mcp__serena__execute_shell_command|mcp__serena_build__execute_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec \"$(git rev-parse --show-toplevel)/.claude/hooks/use-serena.sh\"'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__serena__write_memory|mcp__serena_build__write_memory",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec \"$(git rev-parse --show-toplevel)/.claude/hooks/professor-auto-mark-read.sh\"'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
